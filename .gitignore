# 环境与缓存
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 本地生成的决赛同规模场景：每个约 20 MB，可用 kit/make_scenario.py 按种子重新生成（命令见 README）。
# 蒙特卡洛场景（mc-*）很小（大文件是指向 data/scenarios 的符号链接），纳入版本库
scenarios/comp-*/

# 临时运行产物：评测的完整运行目录、剖析数据、零分结果文件，都可以重跑
runs/eval/
runs/perf/
runs/prof/
runs/zero/

# 构建与评测导出（可由 tools/pack_project.py、build_portfolio.py、zero_score.py 重建）
# 包括完整项目包、历史 agent 包、择优组合和 Playground CSV，不进入版本库。
dist/

# 平台下载的评测结果、agent.log 与 workflow 归档，不作为版本输入。
result_temp/

# Cloudflare telemetry worker local state and credentials
telemetry-worker/node_modules/
telemetry-worker/.wrangler/
telemetry-worker/.dev.vars
telemetry-worker/coverage/

# 环境与缓存
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 本地生成的决赛同规模场景：每个约 20 MB，可用 v3/kit/make_scenario.py 按种子重新生成（命令见 README）。
# 蒙特卡洛场景（mc-*）很小（大文件是指向 v3/data/scenarios 的符号链接），纳入版本库
v3/scenarios/comp-*/

# 临时运行产物：评测的完整运行目录、剖析数据、零分结果文件，都可以重跑；脚本和说明仍保留在 Git
v3/runs/eval/
v3/runs/perf/
v3/runs/prof/
v3/runs/zero/
v3/runs/public_once/
v3/runs/*.json
v3/runs/**/*.json
v3/runs/*.txt
v3/runs/**/*.txt
v3/runs/*.stderr
v3/runs/**/*.stderr
v3/runs/*.log
v3/runs/**/*.log
v3/runs/*.done
v3/runs/**/*.done
v3/runs/**/done
# Reusable experiment inputs and package metadata remain versioned.
!v3/runs/dev_scenarios.txt
!v3/runs/holdout_scenarios.txt
!v3/runs/offline-params.txt
!v3/runs/**/params.json
!v3/runs/**/requirements.txt
!v3/runs/fable-0925c/jobs*.txt
!v3/runs/fable-0925c/order.txt
!v3/runs/platform-2026-09-25/example_*.json
!v3/runs/platform-2026-09-25/example_tree.txt

# 批量评测输出（由 v3/tools/evaluate.py 可重建；磁盘上的旧结果保留，现位于 v3/results/）
results/

# 构建与评测导出（可由 v3/tools/pack_project.py、build_portfolio.py、zero_score.py 重建，现位于 v3/dist/）
# 包括完整项目包、历史 agent 包、择优组合和 Playground CSV，不进入版本库。
dist/

# 平台下载的评测结果、agent.log 与 workflow 归档，不作为版本输入；目录说明除外。
v3/result_temp/*
!v3/result_temp/README.md

# Version-isolated v4 inputs and reproducible artifacts.
/v4/cards/*
!/v4/cards/README.md
!/v4/results/
/v4/results/*
!/v4/results/README.md
!/v4/dist/
/v4/dist/*
!/v4/dist/README.md

# Cloudflare telemetry worker local state and credentials
telemetry-worker/node_modules/
telemetry-worker/.wrangler/
telemetry-worker/.dev.vars
telemetry-worker/coverage/

# 全知排程工具的中间产物（结果表约 17 MB，可由 v3/tools/omni/tables.py 重建）；
# 最终排程另存 v3/agents/public_once/public_schedules.json
v3/runs/omni/
v3/tools/omni/dp.so

# 远程机器凭据（10-06）：只放在 ~/.ssh，不进仓库
*.pem
/server
/servers

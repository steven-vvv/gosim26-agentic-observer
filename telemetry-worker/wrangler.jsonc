{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gosim26-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gosim26-telemetry",
      "database_id": "319bb5f6-f3b1-45ea-845e-3b368f2c99d6",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "CORS_ORIGIN": "*",
    "LLM_DISABLE_THINKING": "true",
    "LLM_MODEL_NAME": "ds/deepseek-flash",
    "LLM_UPSTREAM_TIMEOUT_MS": "20000",
    "TELEMETRY_MAX_BATCH": "32",
    "TELEMETRY_MAX_BODY_BYTES": "262144",
    "TELEMETRY_RETENTION_DAYS": "30"
  }
}
